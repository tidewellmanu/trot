# Frontend / Supabase
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
SITE_URL=https://trotromall.com

# Supabase Edge Function secrets
HUBTEL_ACCOUNT_NUMBER=YOUR_HUBTEL_MERCHANT_ACCOUNT
HUBTEL_API_ID=YOUR_HUBTEL_CLIENT_ID
HUBTEL_API_KEY=YOUR_HUBTEL_CLIENT_SECRET
HUBTEL_CALLBACK_TOKEN=LONG_RANDOM_WEBHOOK_TOKEN
# Keep this configurable because Hubtel can version/migrate API hosts.
HUBTEL_CHECKOUT_ENDPOINT=https://payproxyapi.hubtel.com/items/initiate
HUBTEL_API_BASE_URL=https://payproxyapi.hubtel.com
ALLOWED_ORIGIN=https://trotromall.com
CRON_SECRET=CHANGE_ME_FOR_OPTIONAL_FUNCTION_CRON
